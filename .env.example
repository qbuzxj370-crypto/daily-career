# .env.example — 이 파일을 .env로 복사해서 값을 채운다.
#   cp .env.example .env
#
# ⚠️ .env는 .gitignore에 있고 절대 커밋하지 않는다. 특히 SLACK_WEBHOOK_URL은
#    URL 자체가 비밀이다(아는 사람은 누구나 그 채널에 글을 쓸 수 있다).
#
# ⚠️ GitHub Actions Secrets는 로컬 실행에서 읽히지 않는다. 러너 안에서만 주입되므로
#    로컬(--probe / --dry-run / --init-db)은 이 파일, CI는 Secrets — **양쪽에 각각** 넣는다.
#
# 진단 요령: 키가 안 먹으면 값을 보지 말고 **길이**부터 재라. 접두사만 옮겨 적어 7자가
# 들어가 있던 사고가 upstream에서 있었다. 정상 길이는 아래 주석 참조.

# ── 필수 ────────────────────────────────────────────────────────────────────
# Gemini (aistudio.google.com/apikey). 정상 길이 53자.
GEMINI_API_KEY=

# 노션 내부 통합 토큰 (notion.so/my-integrations). 정상 길이 50자, ntn_ 으로 시작.
NOTION_API_KEY=

# 노션 DB ID. **--init-db로 직접 만든 값**을 넣는다. 정상 길이 36자(하이픈 포함).
# 🚫 upstream(docs/upstream/ref.md §2)에 적힌 DB ID를 쓰지 말 것 — 남의 DB다.
NOTION_DB_ID=

# ── 선택 ────────────────────────────────────────────────────────────────────
# 사람인 오픈API (oapi.saramin.co.kr). 미설정이면 사람인 소스가 자동 비활성화된다.
SARAMIN_ACCESS_KEY=

# 슬랙 Incoming Webhook. 미설정이면 슬랙 단계를 건너뛴다.
SLACK_WEBHOOK_URL=

# 노션 2025-09 API는 data source 단위로 동작한다. 미설정이면 DB에서 자동 해석한다.
NOTION_DATA_SOURCE_ID=

# ── 워크넷은 키가 없다 ──────────────────────────────────────────────────────
# 고용24 OPEN-API는 약관상 법인만 이용 자격이 있어 개인 계정으로는 열리지 않는다.
# 그래서 공개 검색 페이지 파싱으로 받는다(robots.txt 허용 경로). 아래는 조정용.
# WORKNET_CAREER_TYPES=N,Z        # N=신입 E=경력 Z=관계없음
# WORKNET_ACADEMIC_GBN=00,04      # 00=학력무관 04=대졸(2~3년)
# WORKNET_REG_DAYS=2              # 등록일 최근 N일 (일별 수집이면 2)
# WORKNET_REQUEST_GAP=1.0         # 요청 간 최소 간격(초)
